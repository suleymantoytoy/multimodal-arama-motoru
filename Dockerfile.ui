# ============================================================
# Bu dosya, Streamlit arayuzumuzu (ui/app.py) container'a paketler.
# Mantik, Dockerfile.api ile NEREDEYSE AYNI - sadece son komut
# (CMD) farkli, cunku bu sefer uvicorn degil streamlit calistiriyoruz.
# ============================================================

FROM python:3.11-slim

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

EXPOSE 8501

# --server.address=0.0.0.0: ayni "disaridan erisilebilir olma"
# gerekliligi, Streamlit'in kendi parametresiyle.
CMD ["streamlit", "run", "ui/app.py", "--server.address=0.0.0.0", "--server.port=8501"]